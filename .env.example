# ============================================================================
# SATVA — Environment configuration example
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ============================================================================

# --- Core -------------------------------------------------------------------
SATVA_ENV=development
SATVA_DEBUG=true
SATVA_API_PREFIX=/api/v1

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SATVA_SECRET_KEY=CHANGE_ME_dev_only_secret_key_do_not_use_in_production
SATVA_ACCESS_TOKEN_TTL_MIN=60
SATVA_REFRESH_TOKEN_TTL_DAYS=14
# Pepper used when hashing device identifiers before they touch analytics rows.
SATVA_DEVICE_HASH_PEPPER=CHANGE_ME_dev_only_device_pepper

# --- Database ---------------------------------------------------------------
POSTGRES_USER=satva
POSTGRES_PASSWORD=satva_dev_password
POSTGRES_DB=satva
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SATVA_DATABASE_URL=postgresql+psycopg://satva:satva_dev_password@postgres:5432/satva

# Read-only analytics role used by the clustering / heatmap workers.
# This role deliberately has NO grant on the `identity` schema.
SATVA_ANALYTICS_DATABASE_URL=postgresql+psycopg://satva_analytics:satva_analytics_password@postgres:5432/satva
SATVA_ANALYTICS_DB_PASSWORD=satva_analytics_password

# --- Redis / Celery ---------------------------------------------------------
SATVA_REDIS_URL=redis://redis:6379/0
SATVA_CELERY_BROKER_URL=redis://redis:6379/1
SATVA_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO / S3 / Cloudflare R2) ----------------------------
SATVA_S3_ENDPOINT_URL=http://minio:9000
SATVA_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
SATVA_S3_ACCESS_KEY=satva_minio_admin
SATVA_S3_SECRET_KEY=satva_minio_password
SATVA_S3_BUCKET=satva-evidence
SATVA_S3_REGION=us-east-1
MINIO_ROOT_USER=satva_minio_admin
MINIO_ROOT_PASSWORD=satva_minio_password

# --- Uploads ----------------------------------------------------------------
SATVA_MAX_UPLOAD_BYTES=8388608
SATVA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Evidence retention (spec 15.3: images kept only while complaint is live)
SATVA_IMAGE_RETENTION_DAYS=90
SATVA_IMAGE_RETENTION_DAYS_WITH_LIVE_COMPLAINT=730

# --- Rate limiting ----------------------------------------------------------
SATVA_RATE_LIMIT_SCAN_PER_HOUR=40
SATVA_RATE_LIMIT_AUTH_PER_HOUR=10
SATVA_RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Watch / clustering -----------------------------------------------------
SATVA_DBSCAN_EPS_METRES=250
SATVA_DBSCAN_MIN_SAMPLES=3
SATVA_CLUSTER_TIME_WINDOW_DAYS=30
SATVA_CLUSTER_MIN_INDEPENDENT_DEVICES=3
SATVA_PHASH_DUPLICATE_HAMMING_THRESHOLD=8

# --- Firebase phone OTP (optional; app falls back to dev OTP when unset) -----
# Path to the Firebase Admin service-account JSON. Leave blank in development:
# with no credentials the backend uses a DEV OTP provider that prints the code.
SATVA_FIREBASE_CREDENTIALS_FILE=
SATVA_FIREBASE_PROJECT_ID=

# --- FSSAI escalation -------------------------------------------------------
# SATVA never auto-submits. It prepares a package for the statutory channel.
SATVA_FSSAI_PORTAL_URL=https://foodlicensing.fssai.gov.in/cmsweb/
SATVA_FSSAI_CONNECT_APP=FSSAI Food Safety Connect

# --- MQTT (SATVA Node) ------------------------------------------------------
SATVA_MQTT_HOST=mosquitto
SATVA_MQTT_PORT=1883
SATVA_MQTT_TOPIC=satva/node/+/telemetry
SATVA_NODE_INGEST_TOKEN=CHANGE_ME_dev_node_token

# --- Dashboard (Vite build-time) --------------------------------------------
VITE_SATVA_API_BASE=http://localhost:8000/api/v1
VITE_SATVA_MAP_STYLE=https://demotiles.maplibre.org/style.json

# --- Demo seed accounts (created ONLY by scripts/seed_demo.py) --------------
SATVA_SEED_DEMO_PASSWORD=satva-demo-2026
