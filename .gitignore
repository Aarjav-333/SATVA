# ML artefacts (large binaries are not committed; see ml/README.md)
ml/data/
ml/runs/
ml/artifacts/*.pth
ml/artifacts/*.onnx
ml/artifacts/*.tflite
!ml/artifacts/.gitkeep

# Local infra state
infrastructure/volumes/
backend/.demo-tmp/
*.db
*.sqlite3
# The compose beat service writes its schedule to /tmp inside the container, but
# running `celery beat` directly still drops this next to the working directory,
# which is not always backend/. Unanchored so it matches at any depth.
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
